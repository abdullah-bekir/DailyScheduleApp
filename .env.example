# ─────────────────────────────────────────────────────────────────────────────
# Şablon — Bu dosyayı kopyalayıp ".env" yapın ve değerleri kendi projenizden girin.
# ─────────────────────────────────────────────────────────────────────────────
# Supabase → Project Settings → API:
#   • Project URL          → EXPO_PUBLIC_SUPABASE_URL
#   • anon public key      → EXPO_PUBLIC_SUPABASE_ANON_KEY  (veya "Publishable")
#
# Authentication → Providers → Anonymous: AÇIK olmalı (login ekranı yok).
#
# Şifre / postgresql:// bağlantısı mobil uygulamaya YAZILMAZ — sadece bu iki satır.
# ─────────────────────────────────────────────────────────────────────────────

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# AdMob (Google AdMob dashboard değerleri; geliştirme için test ID kullanabilirsiniz)
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-3940256099942544~3347511713
EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-3940256099942544~1458002511
EXPO_PUBLIC_ADMOB_BANNER_ANDROID_UNIT_ID=ca-app-pub-3940256099942544/6300978111
EXPO_PUBLIC_ADMOB_BANNER_IOS_UNIT_ID=ca-app-pub-3940256099942544/2934735716
EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID=ca-app-pub-3940256099942544/6300978111
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ANDROID_UNIT_ID=ca-app-pub-3940256099942544/1033173712
EXPO_PUBLIC_ADMOB_INTERSTITIAL_IOS_UNIT_ID=ca-app-pub-3940256099942544/4411468910
EXPO_PUBLIC_ADMOB_INTERSTITIAL_UNIT_ID=ca-app-pub-3940256099942544/1033173712

# Reklamları göstermek için true yapın (varsayılan: gösterilmez — interstitial, app open, ödüllü)
EXPO_PUBLIC_ADS_UI_ENABLED=

# Tam ekran geçiş reklamı: en az kaç dakika arayla (4–120, öneri 12–20)
EXPO_PUBLIC_ADS_MIN_INTERSTITIAL_MINUTES=15
# App open: en az kaç dakika arayla (10–180, öneri 25–45)
EXPO_PUBLIC_ADS_MIN_APPOPEN_MINUTES=30
# Ödüllü reklam izleyince verilecek bonus tamamlama puanı (1–50)
EXPO_PUBLIC_ADS_REWARD_BONUS_POINTS=5

EXPO_PUBLIC_ADMOB_APP_OPEN_ANDROID_UNIT_ID=ca-app-pub-3940256099942544/9257395921
EXPO_PUBLIC_ADMOB_APP_OPEN_IOS_UNIT_ID=ca-app-pub-3940256099942544/5575463023
EXPO_PUBLIC_ADMOB_APP_OPEN_UNIT_ID=ca-app-pub-3940256099942544/9257395921

EXPO_PUBLIC_ADMOB_REWARDED_INTERSTITIAL_ANDROID_UNIT_ID=ca-app-pub-3940256099942544/5354046379
EXPO_PUBLIC_ADMOB_REWARDED_INTERSTITIAL_IOS_UNIT_ID=ca-app-pub-3940256099942544/6978759866
EXPO_PUBLIC_ADMOB_REWARDED_INTERSTITIAL_UNIT_ID=ca-app-pub-3940256099942544/5354046379

# Rewarded (AdMob birimleri — platforma özel veya genel REWARDED_UNIT_ID)
EXPO_PUBLIC_ADMOB_REWARDED_ANDROID_UNIT_ID=ca-app-pub-3940256099942544/5224354917
EXPO_PUBLIC_ADMOB_REWARDED_IOS_UNIT_ID=ca-app-pub-3940256099942544/1712485313
EXPO_PUBLIC_ADMOB_REWARDED_UNIT_ID=ca-app-pub-3940256099942544/5224354917

# RevenueCat (Proje → API keys — public SDK keys; entitlement varsayılan: premium)
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=premium

# Kaydettikten sonra terminalde: npx expo start   (gerekirse: npx expo start -c)
