{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "channel": "development",
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "image": "sdk-54"
      },
      "ios": {
        "simulator": true,
        "image": "sdk-54"
      }
    },
    "preview": {
      "channel": "preview",
      "environment": "preview",
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "image": "sdk-54"
      },
      "ios": {
        "image": "sdk-54"
      }
    },
    "production": {
      "channel": "production",
      "environment": "production",
      "autoIncrement": false,
      "android": {
        "buildType": "app-bundle",
        "image": "sdk-54"
      },
      "ios": {
        "image": "sdk-54",
        "resourceClass": "m-medium"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./secrets/google-play-service-account.json",
        "track": "internal",
        "releaseStatus": "draft",
        "changesNotSentForReview": true
      },
      "ios": {
        "ascAppId": "6816170357"
      }
    }
  }
}
