{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "jsx": "react-native",
    "lib": ["ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "target": "ES2022"
  },
  "exclude": ["node_modules", "android", "ios", ".expo", "dist", "build"]
}
