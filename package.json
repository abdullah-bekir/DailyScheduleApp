{
  "name": "planly",
  "version": "1.0.4",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:offline": "expo start --offline",
    "start:clear": "expo start -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "eas:whoami": "npx eas-cli whoami",
    "eas:build": "npx eas-cli build",
    "eas:build:preview:android": "npx eas-cli build --profile preview --platform android",
    "eas:build:preview:ios": "npx eas-cli build --profile preview --platform ios",
    "eas:build:production:android": "npx eas-cli build --profile production --platform android",
    "eas:build:production:ios": "npx eas-cli build --profile production --platform ios",
    "eas:build:production:all": "npx eas-cli build --profile production --platform all",
    "eas:submit:android": "npx eas-cli submit --platform android --profile production",
    "eas:submit:ios": "npx eas-cli submit --platform ios --profile production",
    "eas:update:preview": "npx eas-cli update --channel preview",
    "eas:update:production": "npx eas-cli update --channel production",
    "i18n:check": "node scripts/check-i18n.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "@supabase/supabase-js": "^2.110.8",
    "expo": "~54.0.36",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.12",
    "expo-localization": "~17.0.9",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.19",
    "i18next": "^26.3.6",
    "react": "19.1.0",
    "react-i18next": "^17.0.11",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-google-mobile-ads": "^16.4.0",
    "react-native-purchases": "^10.4.4",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^3.0.0"
  },
  "private": true,
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "devDependencies": {
    "babel-preset-expo": "~54.0.12"
  },
  "overrides": {
    "expo": {
      "@expo/vector-icons": "$@expo/vector-icons",
      "expo-constants": "$expo-constants",
      "expo-font": "$expo-font"
    }
  }
}
